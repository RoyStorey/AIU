# Required for the forge: drafting new faculties, concentrations, courses, and continuations.
# Without it, the authored catalogue and courses still work fully.
ANTHROPIC_API_KEY=

# Optional: the Claude model the forge uses (default: claude-opus-5-5).
# AIU_MODEL=claude-opus-5-5

# Optional: where the SQLite database lives (default: data/aiu.db).
# AIU_DATABASE=data/aiu.db
