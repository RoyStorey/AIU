# Required for the forge: drafting new faculties, concentrations, courses, and continuations.
# Without it, the authored catalogue and courses still work fully.
ANTHROPIC_API_KEY=

# Optional: the Claude model the forge uses (default: claude-opus-5-5).
# AIU_MODEL=claude-opus-5-5

# Optional: where the SQLite database lives (default: data/university.db).
# AIU_DATABASE=data/university.db

# Optional: emails of faculty members, comma-separated. Faculty can answer and
# settle the error reports students post in each lesson's Comments & Corrections.
# AIU_FACULTY_EMAILS=dean@example.com

# Optional: set to "off" to remove the sample students (a Master of Poetry, an
# Expert, and a student midway through) and everything they wrote.
# AIU_DEMO=off

# Optional: set to "off" to stop looking books up in Open Library's catalogue.
# Books are then shown with searches of libraries and booksellers instead.
# AIU_BOOK_LOOKUP=off

# Optional: whether the session cookie is marked Secure (HTTPS only). By default
# it is marked Secure only when the visitor arrived over HTTPS (directly, or via
# a proxy that sends X-Forwarded-Proto: https), so a site shared over plain HTTP
# still keeps people signed in. Set to "true" or "false" to override.
# AIU_SECURE_COOKIES=true

# Optional: emails of administrators, comma-separated. Administrators see an
# Admin link in the header and can delete inactive accounts at /admin. They may
# also answer correction reports, like faculty.
# AIU_ADMIN_EMAILS=you@example.com

# Optional: listening. Courses with narration, by code, comma-separated, or "all"
# (default: AMH 101, the testbed).
# AIU_NARRATION_COURSES=AMH 101

# Optional: where studio voices come from. "kokoro" (default) runs the open
# Kokoro model on this server, free; "openai" uses OpenAI's speech API and needs
# OPENAI_API_KEY; "off" offers only the voices on each student's own device.
# AIU_NARRATION_PROVIDER=kokoro
# OPENAI_API_KEY=
# AIU_OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Optional: who may cause narration to be rendered on demand by listening:
# "signed-in" (default), "admins", or "off" (only audio rendered in advance with
# `npm run narrate` is played; other passages fall back to device voices).
# AIU_NARRATION_ON_DEMAND=signed-in

# Optional: where rendered narration and the Kokoro model are kept.
# AIU_NARRATION_DIR=data/narration
# AIU_KOKORO_DIR=data/models/kokoro
