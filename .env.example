# Claude API key: required to generate curriculum, optional for AI assignment grading.
ANTHROPIC_API_KEY=

# Model used for generation and grading (default: claude-opus-5-5).
# AIU_MODEL=claude-opus-5-5

# Set to "off" to award completion credit instead of AI feedback on assignments.
# AIU_AI_GRADING=on

# SQLite file locally; a libsql:// URL (e.g. Turso) in production.
DATABASE_URL=file:./data/aiu.db
# DATABASE_AUTH_TOKEN=

# Comma-separated emails that can open the admin panel at /admin.
# AIU_ADMIN_EMAILS=you@example.com

# Development only: pretend today is this date, to test cohort and term dates.
# AIU_TODAY=2027-01-13

# Optional Amazon Associates tag added to book links.
# AIU_AMAZON_TAG=
